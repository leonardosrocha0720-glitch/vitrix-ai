# Nunca commite suas chaves reais; esse arquivo é só um modelo.

# Busca de negócios (SerpAPI — engine google_maps)
SERPAPI_KEY=coloque-sua-chave-aqui

# Geração de sites com IA (Anthropic)
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Imagens reais nos sites gerados (opcional — sem ela, usa gradientes CSS)
UNSPLASH_ACCESS_KEY=coloque-sua-chave-aqui

# Supabase (auth + banco). Em Project Settings > API no dashboard do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-sua-anon-key-aqui

# URL pública do app (usada nos links dos sites publicados e no callback de cadastro)
NEXT_PUBLIC_APP_URL=http://localhost:3000
